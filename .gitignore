# Python
.venv/
__pycache__/

# osmnx download cache (re-created automatically)
cache/

# Road network built by --build-graph (large; rebuild with
#   python whereto.py --build-graph porto.graphml)
*.graphml

# Landmarks built by --build-landmarks (rebuild with
#   python whereto.py --build-landmarks porto_landmarks.geojson)
*_landmarks.geojson

# Generated outputs
*_map.png
*_regions.csv
*_places.csv

# Local Claude Code settings
.claude/settings.local.json
CLAUDE.md
